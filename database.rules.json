{
  "rules": {
    "ubicaciones": {
      ".read": true,
      "$busId": {
        ".write": "auth != null && newData.child('conductorId').val() == auth.uid",
        ".validate": "newData.hasChildren(['lat','lng','activo','actualizado','conductorId'])",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    }
  }
}
