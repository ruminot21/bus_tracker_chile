rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function isAdmin() {
      return profileExists() && profile().rol == "admin";
    }

    function isCompany() {
      return profileExists() && profile().rol == "empresa";
    }

    function isDriver() {
      return profileExists() && profile().rol == "conductor";
    }

    function sameCompany(companyId) {
      return isCompany() && profile().empresaId == companyId;
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (
          isCompany() &&
          resource.data.empresaId == profile().empresaId
        )
      );

      // Las cuentas y cambios sensibles se realizan mediante Cloud Functions.
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /empresas/{companyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /buses/{busId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin() ||
        (
          isDriver() &&
          profile().busId == busId
        );
    }

    match /rutas/{routeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /incidencias/{incidentId} {
      allow create: if isDriver() || isAdmin();

      allow read: if isAdmin() ||
        (
          isCompany() &&
          resource.data.empresaId == profile().empresaId
        );

      allow update: if isAdmin() ||
        (
          isCompany() &&
          resource.data.empresaId == profile().empresaId
        );

      allow delete: if isAdmin();
    }
  }
}
